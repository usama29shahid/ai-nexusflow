NEXUS_ENV=dev

# Docker Compose stacks. MinIO always starts (no profile).
# clickhouse | lakehouse | airflow — comma-separated for more than one.
COMPOSE_PROFILES=clickhouse,lakehouse

# --- Warehouse (dlt_dbt_clickhouse) ---
# Used by Docker Compose and by dbt (export/source .env before `uv run dbt`).
CLICKHOUSE_HOST=localhost
CLICKHOUSE_DB=warehouse
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=change-me

CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000

# --- Shared object store (MinIO) ---
MINIO_API_PORT=9002
MINIO_CONSOLE_PORT=9001

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123

# --- Lakehouse (dlt_dbt_spark_iceberg) ---
AWS_REGION=us-east-1

POLARIS_HTTP_PORT=8181
POLARIS_MGMT_PORT=8182
POLARIS_CLIENT_ID=root
POLARIS_CLIENT_SECRET=s3cr3t

SPARK_THRIFT_HOST=localhost
SPARK_THRIFT_PORT=10000
SPARK_THRIFT_USER=dbt
SPARK_UI_PORT=4040

TRINO_PORT=8080
