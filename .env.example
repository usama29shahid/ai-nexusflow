NEXUS_ENV=dev

# Secrets: env = .env (local WSL default); vault = HashiCorp Vault KV + Agent (VPS target).
# When vault: run ./scripts/setup.sh — seeds from .env once, then secrets live in Vault only.
NEXUS_SECRETS_BACKEND=env
VAULT_ADDR=http://127.0.0.1:8200
VAULT_PORT=8200
# NEXUS_SECRETS_FILE=.nexusflow/secrets.env   # Agent output (default)
# NEXUS_SECRETS_GROUP=nexusflow   # optional: shared Linux group so a dev user can read secrets.env (mode 640)

# Docker Compose stacks. MinIO always starts (no profile).
# Set NEXUS_SECRETS_BACKEND=vault to start Vault via ./scripts/start.sh (do not add vault to COMPOSE_PROFILES).
# clickhouse | lakehouse | cloudbeaver | airflow | proxy — comma-separated for more than one.
# Airflow / proxy are on-demand: omit from the default; add when needed, or:
#   docker compose --profile airflow up -d
#   docker compose --profile proxy up -d   # or ./scripts/start.sh proxy
COMPOSE_PROFILES=clickhouse,lakehouse,cloudbeaver

# --- Warehouse (dlt_dbt_clickhouse) ---
# Compose bootstrap admin (CREATE USER / GRANT). See docs/rbac.md.
CLICKHOUSE_HOST=localhost
CLICKHOUSE_DB=warehouse
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=change-me

# Process users (products cutover). Passwords default to CLICKHOUSE_PASSWORD if unset in scripts.
CLICKHOUSE_LOADER_USER=nexus_loader
CLICKHOUSE_LOADER_PASSWORD=change-me
CLICKHOUSE_TRANSFORMER_USER=nexus_transformer
CLICKHOUSE_TRANSFORMER_PASSWORD=change-me
CLICKHOUSE_READER_USER=nexus_reader
CLICKHOUSE_READER_PASSWORD=change-me
CLICKHOUSE_ADMIN_USER=nexus_admin
CLICKHOUSE_ADMIN_PASSWORD=change-me

CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000

# --- Shared object store (MinIO) ---
MINIO_API_PORT=9002
MINIO_CONSOLE_PORT=9001
# Optional override (default http://localhost:$MINIO_API_PORT). Compose/Airflow: http://minio:9000
# MINIO_ENDPOINT_URL=http://localhost:9002

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123

# --- Observability (always on with MinIO) ---
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318
OTEL_HEALTH_PORT=13133
# Host pipelines: export OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4317

# --- Observability readers (optional Compose profiles) ---
SIGNOZ_UI_PORT=3301
# SIGNOZ_STANDALONE_VERSION=latest
OPENMETADATA_SERVER_PORT=8585
OPENMETADATA_ADMIN_PORT=8586
OPENMETADATA_POSTGRES_PORT=5433
OPENMETADATA_ELASTICSEARCH_PORT=9200
# Catalog search index only (not upstream 1 GB heap). Optional ingestion Airflow: profile openmetadata-ingestion.
OPENMETADATA_ES_JAVA_OPTS=-Xms256m -Xmx256m
OPENMETADATA_ES_MEM_LIMIT=1g
OPENMETADATA_INGESTION_PORT=8089

# --- Lakehouse (dlt_dbt_spark_iceberg) ---
AWS_REGION=us-east-1

POLARIS_HTTP_PORT=8181
POLARIS_MGMT_PORT=8182
POLARIS_CLIENT_ID=root
POLARIS_CLIENT_SECRET=s3cr3t

SPARK_THRIFT_HOST=localhost
SPARK_THRIFT_PORT=10000
SPARK_THRIFT_USER=dbt
SPARK_UI_PORT=4040

TRINO_PORT=8080
CLOUDBEAVER_PORT=8978

# --- Airflow (profile: airflow, on-demand) ---
# UI: http://127.0.0.1:8081  (Trino keeps 8080)
# Prefer your host UID so container log writes match the developer account:
#   AIRFLOW_UID=$(id -u)
# Do not chown orchestration/airflow/dags or plugins — those stay host-owned.
AIRFLOW_UID=1000
AIRFLOW_WEBSERVER_PORT=8081
# LOCAL WSL ONLY. Change before any shared host / VPS / demos with network peers.
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change-me
# Leave blank here. ./scripts/setup.sh fills unique values into .env (required by Compose).
# Manual: python3 -c 'import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())'
AIRFLOW__CORE__FERNET_KEY=
# Manual: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
AIRFLOW__WEBSERVER__SECRET_KEY=
# Airflow 3 api-server JWT (required; shared by api-server, scheduler, dag-processor).
# Manual: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
AIRFLOW__API_AUTH__JWT_SECRET=

# --- Edge proxy (profile: proxy) — docs/edge-proxy.md ---
# local = WSL hosts file + HTTP (Caddyfile.local). vps = DNS + HTTPS (Caddyfile.vps).
# Terraform/Actions set vps — no manual Caddyfile edit on the server.
# Do not set NEXUS_EDGE_MODE=vps on a laptop, and do not leave local on a public VM.
NEXUS_EDGE_MODE=local
# Host suffix for Caddy site names.
# Local: requires ./scripts/proxy-hosts.sh install (not RFC *.localhost).
# VPS: real domain + DNS A records — do not use proxy-hosts.sh as production DNS.
NEXUS_PUBLIC_HOST=localhost.com
# Site address prefix. Local: leave empty (entrypoint uses http://) or set http://
# VPS: leave empty so hostnames are bare domains for Let's Encrypt.
NEXUS_CADDY_SITE_SCHEME=
# Required when NEXUS_EDGE_MODE=vps (entrypoint fails closed if missing).
# NEXUS_CADDY_ACME_EMAIL=ops@example.com
# Backend host publish bind (ClickHouse/MinIO/Polaris/Spark/Trino). Caddy 80/443 stay public.
# Compose default is 127.0.0.1 (safe for raw `docker compose` on a VPS).
# Local via ./scripts/start.sh opens 0.0.0.0 unless you set this. Never use 0.0.0.0 on a VPS
# (start.sh and Caddy entrypoint refuse NEXUS_EDGE_MODE=vps + NEXUS_PUBLISH_BIND=0.0.0.0).
# NEXUS_PUBLISH_BIND=0.0.0.0
NEXUS_PROXY_HTTP_PORT=80
NEXUS_PROXY_HTTPS_PORT=443
# Uncomment ONLY when profile proxy is running (add proxy to COMPOSE_PROFILES or ./scripts/start.sh proxy).
# If these stay set while Caddy is down, Airflow redirects/links break on :8081.
# Local examples:
# AIRFLOW__API__BASE_URL=http://airflow.localhost.com
# AIRFLOW__WEBSERVER__BASE_URL=http://airflow.localhost.com
# AIRFLOW__WEBSERVER__ENABLE_PROXY_FIX=True
# MINIO_BROWSER_REDIRECT_URL=http://minio.localhost.com
# VPS examples (Terraform/deploy):
# AIRFLOW__API__BASE_URL=https://airflow.example.com
# AIRFLOW__WEBSERVER__BASE_URL=https://airflow.example.com
# AIRFLOW__WEBSERVER__ENABLE_PROXY_FIX=True
# MINIO_BROWSER_REDIRECT_URL=https://minio.example.com

# ELT job image (Airflow docker run → nexus-elt). Required for Airflow profile.
# Absolute host clone path (Docker daemon bind-mounts this into each job container).
# NEXUS_REPO_ROOT=/home/india/projects/ai-nexusflow
# Optional overrides:
# NEXUS_ELT_IMAGE=nexus-elt:latest
# NEXUS_COMPOSE_NETWORK=ai-nexusflow_default
# DOCKER_GID=1001
# DOCKER_SOCK=/var/run/docker.sock
# NEXUS_AIRFLOW_ELT_ENV=.nexusflow/airflow_elt.env
