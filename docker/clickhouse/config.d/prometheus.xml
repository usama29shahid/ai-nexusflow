<!-- ClickHouse Prometheus metrics for OTel scrape (Compose network only).
     Bound to 0.0.0.0 inside the container; do NOT publish :9363 on the host. -->
<clickhouse>
  <prometheus>
    <endpoint>/metrics</endpoint>
    <port>9363</port>
    <metrics>true</metrics>
    <events>true</events>
    <asynchronous_metrics>true</asynchronous_metrics>
  </prometheus>
</clickhouse>
